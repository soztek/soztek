generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  emoji     String?
  imageUrl  String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  compareAt   Decimal?    @db.Decimal(10, 2) // eski/liste fiyatı (indirim rozeti için)
  unit        String? // "Adet", "Kutu" vb.
  brand       String? // ürün markası (Asus, MSI, Logitech ...)
  sku         String? // stok/ürün kodu
  imageUrl    String?
  images      String[]    @default([])
  stock       Int         @default(100)
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  freeShip    Boolean     @default(false) // ücretsiz kargo rozeti
  rating      Float       @default(5)
  reviewCount Int         @default(0)
  order       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id            String        @id @default(cuid())
  orderNo       String        @unique
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  fullName String
  email    String
  phone    String
  address  String  @db.Text
  city     String
  district String?
  note     String? @db.Text

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  iyziToken     String?
  iyziPaymentId String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

// Müşteri üyeliği
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  city         String?
  address      String?  @db.Text
  createdAt    DateTime @default(now())
  orders       Order[]

  @@index([email])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unit      String?
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// Site geneli ayarlar (tek satır, id = "main")
model Setting {
  id                String  @id @default("main")
  siteName          String  @default("SÖZTEK Bilgisayar")
  tagline           String  @default("Bilişim & Teknoloji Çözümleri")
  phone             String  @default("0236 612 75 10")
  whatsapp          String  @default("905457698352")
  email             String  @default("soztek@soztekbilgisayar.com.tr")
  instagram         String  @default("soztekbilgisayar")
  address           String  @default("Namazgah Mah. Nazım Usluoğlu Cad. No:45, Soma / MANİSA")
  freeShippingLimit Decimal @db.Decimal(10, 2) @default(5000)
  shippingFee       Decimal @db.Decimal(10, 2) @default(149.90)
  heroTitle         String  @default("Teknolojinin Güç Merkezi")
  heroSubtitle      String  @default("Bilgisayar, donanım, çevre birimleri ve daha fazlası; en uygun fiyatlarla, hızlı kargoyla kapınızda.")
  announcement      String  @default("₺5000 ve üzeri alışverişlerde ÜCRETSİZ kargo — Aynı gün kargo fırsatı")
  updatedAt         DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
